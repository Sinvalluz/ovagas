generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id String @id @db.Uuid
  email String @unique
  name String
  role Role
  imgUrl String?
  createdAt DateTime
  updatedAt DateTime

  @@map("users")
}
